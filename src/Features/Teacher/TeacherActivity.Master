<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="TeacherActivity.master.cs" Inherits="InSchool.src.Features.Teacher.TeacherDashboard" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>inSchool - Teacher Portal</title>
    
    <link href="../../../Styles.css" rel="stylesheet" type="text/css" />
    
    <style>
        /* ==========================================
           GAMING THEME DEFINITIONS & CSS VARIABLES
           ========================================== */
        :root {
            --bg-canvas: #05050a; /* Obsidian Black */
            --bg-card: #121214;   /* Dark Grey for cards */
            --text-main: #f8fafc; /* Crisp White */
            --text-muted: #94a3b8; /* Slate Grey for secondary text */
            --border-color: rgba(220, 38, 38, 0.3); 
            --nav-bg: linear-gradient(90deg, #dc2626, #10b981, #dc2626); /* The R-G-R Gaming Gradient */
            --nav-shadow: 0 4px 20px rgba(16, 185, 129, 0.15); /* Subtle green shadow for teacher */
            --accent-gold: #fbbf24;
            --accent-red: #ef4444;
            --accent-green: #10b981;
        }

        /* Base Reset */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* Ambient Background Glow (Matches Login & Admin) */
        .background-fx {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(220, 38, 38, 0.05) 0%, transparent 40%), 
                radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
            animation: pulseBg 10s infinite alternate ease-in-out;
            pointer-events: none;
        }

        @keyframes pulseBg {
            0% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        .teacher-layout {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* 1. Dynamic Gaming Navbar */
        .top-navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(9, 9, 11, 0.85); /* Dark Glass */
            backdrop-filter: blur(12px);
            border-bottom: 2px solid;
            border-image: var(--nav-bg) 1; /* Animated border */
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 75px;
            box-shadow: var(--nav-shadow);
        }

        /* 2. Brand Identity */
        .nav-left {
            display: flex;
            align-items: center;
            height: 100%;
            gap: 15px;
        }

        .nav-left h2 {
            margin: 0;
            margin-right: 40px;
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #ffffff, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(255,255,255,0.1);
        }

        /* 3. Navigation Links (Sharp Gaming Hover) */
        .nav-btn {
            background-color: transparent;
            color: var(--text-muted);
            border: none;
            height: 100%;
            padding: 0 18px;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            cursor: pointer;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-btn:hover, .nav-btn.active {
            color: var(--text-main);
        }

        /* The Gold Underline Trick */
        .nav-btn::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 3px;
            background: var(--accent-gold);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 -2px 10px rgba(251, 191, 36, 0.5);
        }

        .nav-btn:hover::after, .nav-btn.active::after {
            width: 100%;
        }

        /* 4. Right Side Actions */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .teacher-info {
            text-align: right;
            line-height: 1.2;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .teacher-name {
            color: var(--accent-gold);
            font-weight: 800;
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .teacher-subject {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            margin-top: 4px;
        }

        /* 5. Stealth Logout Button */
        .btn-logout {
            background: transparent;
            color: var(--accent-red);
            border: 2px solid var(--accent-red);
            padding: 8px 20px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-logout:hover {
            background: var(--accent-red);
            color: #ffffff;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
            transform: translateY(-1px);
        }

        /* 6. Main Content Area */
        .main-content {
            flex-grow: 1;
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Global Child Overrides to enforce Dark Mode on child pages */
        .page-title { color: var(--text-main) !important; }
        .page-subtitle { color: var(--text-muted) !important; }
        .glass-card { 
            background: var(--bg-card) !important; 
            border-color: #27272a !important; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important;
        }
        .form-label { color: var(--text-muted) !important; }
        .form-control-modern, .search-bar-modern, .passcode-input { 
            background-color: #09090b !important; 
            border-color: #27272a !important; 
            color: var(--text-main) !important; 
        }
        .form-control-modern:focus, .search-bar-modern:focus, .passcode-input:focus {
            border-color: var(--accent-gold) !important;
            box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15) !important;
        }
        .modern-table th { background-color: #09090b !important; border-bottom-color: #27272a !important; color: var(--text-muted) !important; }
        .modern-table td { background-color: #121214 !important; border-color: #27272a !important; color: var(--text-main) !important; }
        .modern-table tr:hover td { background-color: #18181b !important; }
    </style>
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="background-fx"></div>
        <div class="teacher-layout">
            
            <div class="top-navbar">
                
                <div class="nav-left">
                    <h2>inSchool Teacher</h2>
                    
                    <asp:Button ID="btnCreateQuiz" runat="server" Text="Create Quiz" CssClass="nav-btn" OnClick="btnCreateQuiz_Click" CausesValidation="false" />
                    <asp:Button ID="btnGrades" runat="server" Text="Grades Statistics" CssClass="nav-btn" OnClick="btnGrades_Click" CausesValidation="false" />
                </div>

                <div class="nav-right">
                    <div class="teacher-info">
                        <asp:Label ID="lblTeacherName" runat="server" CssClass="teacher-name"></asp:Label>
                        <asp:Label ID="lblTeacherSubject" runat="server" CssClass="teacher-subject"></asp:Label>
                    </div>
                    
                    <asp:Button ID="btnLogout" runat="server" Text="Log Out" CssClass="btn-logout" OnClick="btnLogout_Click" CausesValidation="false" />
                </div>

            </div>

            <div class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            

        </div>
    </form>
</body>
</html>