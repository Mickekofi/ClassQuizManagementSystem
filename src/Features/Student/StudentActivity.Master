<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentActivity.master.cs" Inherits="InSchool.src.Features.Student.StudentActivity" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>inSchool - Student Portal</title>
    
    <link href="../../../Styles.css" rel="stylesheet" type="text/css" />
    
    <style>
        /* ==========================================
           PROFESSIONAL DARK THEME & AMBIENT FX
           ========================================== */
        :root {
            --bg-canvas: #09090b; /* Matte Obsidian */
            --bg-card: #18181b;   /* Slightly lighter grey for cards */
            --text-main: #f8fafc; /* Crisp White */
            --text-muted: #a1a1aa; /* Slate Grey */
            --border-color: #27272a; 
            --accent-blue: #2563eb; /* Corporate Azure Blue */
            --accent-blue-hover: #3b82f6;
        }

        /* Base Reset & Global Ambient Background (Matches Login) */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* Atmospheric Background Glow Layer */
        .ambient-bg-wrapper {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            background-color: #05050a;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(37, 99, 235, 0.12) 0%, transparent 40%), 
                radial-gradient(circle at 85% 80%, rgba(16, 185, 129, 0.10) 0%, transparent 40%);
            animation: pulseBackground 8s ease-in-out infinite alternate;
            pointer-events: none;
        }

        @keyframes pulseBackground {
            0% { opacity: 0.7; }
            100% { opacity: 1; }
        }

        .student-layout {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* 1. Professional Dark Navbar */
        .top-navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(9, 9, 11, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 2px solid var(--accent-blue);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 75px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        /* 2. Brand Identity */
        .nav-left {
            display: flex;
            align-items: center;
            height: 100%;
            gap: 15px;
        }

        .nav-left h2 {
            margin: 0;
            margin-right: 40px;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #ffffff;
        }

        /* 3. Navigation Links */
        .nav-btn {
            background-color: transparent;
            color: var(--text-muted);
            border: none;
            height: 100%;
            padding: 0 18px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            position: relative;
            transition: color 0.2s ease;
        }

        .nav-btn:hover, .nav-btn.active {
            color: #ffffff;
        }

        .nav-btn::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 3px;
            background: var(--accent-blue);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-btn:hover::after, .nav-btn.active::after {
            width: 100%;
        }

        /* 4. Right Side Actions */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .student-info {
            text-align: right;
            line-height: 1.2;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .student-name {
            font-weight: 700;
            font-size: 14px;
            color: #ffffff;
        }

        .student-role {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* 5. Professional Logout Button */
        .btn-logout {
            background: transparent;
            color: #d1d5db;
            border: 1px solid #3f3f46;
            padding: 8px 20px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-logout:hover {
            background: #27272a;
            color: #ffffff;
            border-color: #52525b;
        }

        /* 6. Main Content Area */
        .main-content {
            flex-grow: 1;
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
            animation: pageFadeIn 0.4s ease-out;
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Global Child Overrides to enforce Dark Mode on child pages */
        .page-title { color: var(--text-main) !important; }
        .page-subtitle { color: var(--text-muted) !important; }
        .glass-card { 
            background: var(--bg-card) !important; 
            border-color: var(--border-color) !important; 
            box-shadow: 0 8px 30px rgba(0,0,0,0.4) !important;
        }
        .form-label { color: var(--text-muted) !important; }
        .form-control-modern, .search-bar-modern, .passcode-input { 
            background-color: #09090b !important; 
            border-color: #3f3f46 !important; 
            color: var(--text-main) !important; 
        }
        .form-control-modern:focus, .search-bar-modern:focus, .passcode-input:focus {
            border-color: var(--accent-blue) !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2) !important;
        }
        .modern-table th { background-color: #09090b !important; border-bottom-color: #3f3f46 !important; color: var(--text-muted) !important; }
        .modern-table td { background-color: #18181b !important; border-color: #27272a !important; color: var(--text-main) !important; }
        .modern-table tr:hover td { background-color: #27272a !important; }
    </style>
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Global Ambient Background Glow Rendered Across All Student Pages -->
        <div class="ambient-bg-wrapper"></div>

        <div class="student-layout">
            
            <div class="top-navbar">
                
                <div class="nav-left">
                    <h2>inSchool Student</h2>
                    
                    <asp:Button ID="btnCourses" runat="server" Text="Available Courses" CssClass="nav-btn" OnClick="btnCourses_Click" CausesValidation="false" />
                    <asp:Button ID="btnHistory" runat="server" Text="My Submissions" CssClass="nav-btn" OnClick="btnHistory_Click" CausesValidation="false" />
                </div>

                <div class="nav-right">
                    <div class="student-info">
                        <asp:Label ID="lblStudentName" runat="server" CssClass="student-name"></asp:Label>
                        <span class="student-role">Student Portal</span>
                    </div>
                    
                    <asp:Button ID="btnLogout" runat="server" Text="Sign Out" CssClass="btn-logout" OnClick="btnLogout_Click" CausesValidation="false" />
                </div>

            </div>

            <div class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            
        </div>
    </form>
</body>
</html>